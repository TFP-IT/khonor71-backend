{
    "name": "laravel/laravel",
    "version": "13",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "abraham/twitteroauth": "^7.0|^8.0",
        "akaunting/laravel-firewall": "^3.0",
        "artesaos/seotools": "^1.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "brian2694/laravel-toastr": "^5.57",
        "doctrine/dbal": "^3.6|^4.0",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^2.7",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.21",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "laravellux/html": "^7.1",
        "league/flysystem-aws-s3-v3": "^3.28",
        "maatwebsite/excel": "^3.1",
        "milon/barcode": "^13.5",
        "nwidart/laravel-modules": "^13.0",
        "php-ffmpeg/php-ffmpeg": "^1.4",
        "rats/zkteco": "^002.0",
        "realrashid/sweet-alert": "^7.2|^8.0",
        "sentry/sentry-laravel": "^4.28",
        "simplepie/simplepie": "^1.5",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-backup": "^10.0",
        "spatie/laravel-permission": "^8.0",
        "stichoza/google-translate-php": "^5.1",
        "yajra/laravel-datatables": "^13.0",
        "yajra/laravel-datatables-buttons": "^13.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.16",
        "laravel/sail": "^1.30",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "platform-check": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
